# Copy to .env and fill in. .env is gitignored: never commit a real key.

# Run directory inside the container. /runs/demo is built automatically from the bundled demo data.
# After training your own (see README), point this at it, for example /runs/mine.
CALLSWAP_RUN_DIR=/runs/demo

# The LLM that low-confidence requests fall back to: any OpenAI-compatible chat-completions URL.
# Leave empty to run without a fallback (unsure answers are then marked x-callswap-route: local-unsure).
TEACHER_URL=https://api.openai.com/v1/chat/completions
# Model name sent to the teacher. Leave empty to keep whatever model the caller asked for.
TEACHER_MODEL=
# Your own key for the teacher. Leave empty to forward the caller's Authorization header instead.
TEACHER_API_KEY=your-key-here

# 1 = shadow mode: every request is answered by the teacher, and callswap logs whether it would have agreed.
CALLSWAP_SHADOW=0

# Host port to publish on 127.0.0.1.
CALLSWAP_PUBLISHED_PORT=8000
